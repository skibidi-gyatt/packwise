{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:build": "vite build --config mobile/vite.config.ts",
    "ios:sync": "npm run mobile:build && cap sync ios && node scripts/prepare-ios.mjs",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/core": "8.5.1",
